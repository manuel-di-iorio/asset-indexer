{
  "name": "asset-indexer",
  "version": "1.1.0",
  "description": "Intelligent asset indexer for game developers",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "author": "Asset Indexer",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.assetindexer.app",
    "productName": "Asset Indexer",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "src/renderer/icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/renderer/icon.ico",
      "target": ["nsis", "portable"],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
