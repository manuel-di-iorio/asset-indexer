{
  "name": "asset-indexer",
  "version": "1.0.0",
  "description": "Intelligent asset indexer for game developers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Asset Indexer",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.assetindexer.app",
    "productName": "Asset Indexer",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "renderer/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
